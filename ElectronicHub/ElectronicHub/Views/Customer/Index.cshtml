<script src="~/Content/Jquery/3.5.1/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        LoadProducts();
        updateCartCount();

        $("#searchInput").on("keyup", function () {
            let searchText = $(this).val().trim().toLowerCase(); // Get input and make lowercase

            $("#productsContainer .col-lg-3").each(function () {
                let productName = $(this).find(".card-title").text().trim().toLowerCase(); // Get product name
                // Show/hide products based on search match
                $(this).toggle(productName.includes(searchText));
            });
        });
    });

    function CallAI() {
        alert("AI");
    }
    //Animation

    const overlay = document.querySelector('.container2');

            // Array of electronic component images (Replace with actual paths)
            const componentImages = [
                '@Url.Content("~/Resources/cap1.png")',
                '@Url.Content("~/Resources/cap2.png")',
                '@Url.Content("~/Resources/cap3.png")',
                '@Url.Content("~/Resources/cap4.png")',
                '@Url.Content("~/Resources/cap5.png")',
                '@Url.Content("~/Resources/cap6.png")',
                '@Url.Content("~/Resources/cap7.png")',
                '@Url.Content("~/Resources/cap8.png")',
                '@Url.Content("~/Resources/cap9.png")',
                '@Url.Content("~/Resources/cap10.png")'

            ];


            function createComponent() {
                if (document.querySelectorAll('.component').length >= 30) return; // Limit max components on screen

                let component = document.createElement("div");
                component.classList.add("component");
                component.style.left = `${Math.random() * window.innerWidth}px`;
                component.style.top = `${Math.random() * window.innerHeight}px`;
                component.style.backgroundImage = `url(${componentImages[Math.floor(Math.random() * componentImages.length)]})`;
                component.style.animationDelay = `${Math.random() * 1.5}s`; // Random delay
                overlay.appendChild(component);

                // Remove the component after animation completes
                setTimeout(() => {
                    component.remove();
                }, 5000); // Matches fadeInOut animation time
            }

            // Create new components rapidly
            setInterval(() => {
                createComponent();
            }, 300); // Spawn new component every 300ms

    function proceedToCheckout() {
        window.location.href = '@Url.Action("Checkout", "Customer")';
    }
    //End Animation

    // Load Cart Data from DB or Local Storage
    function loadCart() {
        $.ajax({
            url: "/Customer/GetCartItems",
            method: "GET",
            success: function (response) {
                if (response.sessionAvailable) {
                    renderCart(response.data);
                } else {
                    // Load from localStorage
                    let localCart = JSON.parse(localStorage.getItem("cart")) || [];

                    if (localCart.length > 0) {
                        // Fetch images for localStorage items using ItemID
                        let itemIds = localCart.map(item => item.ItemID);

                        $.post("/Customer/GetImagesForItems", { itemIds: itemIds })
                            .done(function (imageResponse) {

                                localCart.forEach(item => {

                                    // Convert both to string for safe comparison
                                    let matchedImage = imageResponse.find(img => String(img.ItemID) === String(item.ItemID));

                                    if (matchedImage) {
                                        item.Item_Image1 = matchedImage.Item_Image1; // Assign image correctly
                                    } else {
                                        console.warn("No image found for ItemID:", item.ItemID);
                                        item.Item_Image1 = "default.jpg"; // Fallback image
                                    }
                                });

                                console.log("Final Cart Data Before Render:", localCart); // Check before rendering

                                renderCart(localCart);
                            })
                            .fail(function (xhr, status, error) {
                                console.error("AJAX Request Failed:", status, error);
                            });

                    } else {

                        renderCart([]);
                    }
                }
            }
        });
    }

    // Render Cart Items
    function renderCart(cartItems) {
        let cartTable = $("#cart-items");
        cartTable.empty();
        let subtotal = 0;

        cartItems.forEach(item => {
            let itemTotal = item.Item_Price * item.ItemQuantity;
            subtotal += itemTotal;
            cartTable.append(`
                <tr data-id="${item.ItemID}">
                    <td><img src="${item.Item_Image1}" width="80" height="80" ></td>
                    <td>${item.ItemName}</td>
                    <td data-stock="${item.StockQuantity}">${item.StockQuantity}</td>
                    <td>Rs.${item.Item_Price}</td>
                    <td>
                        <button class="btn btn-sm btn-light decrease">-</button>
                        <span class="px-2" data-ItemQuantity="${item.ItemQuantity}">${item.ItemQuantity}</span>
                        <button class="btn btn-sm btn-light increase">+</button>
                    </td>
                    <td>Rs.${itemTotal.toFixed(2)}</td>
                    <td><button class="btn btn-danger btn-sm remove-item">X</button></td>
                </tr>
            `);
        });

        $("#cart-subtotal").text(`Rs.${subtotal.toFixed(2)}`);
        $("#cart-count").text(cartItems.length);
    }

    // Increase Quantity
    $(document).on("click", ".increase", function () {
        var row = $(this).closest("tr");
        var itemId = row.data("id");
        var stock = row.find("td[data-stock]").data("stock");
        var qty = row.find("span[data-ItemQuantity]").data("ItemQuantity");

        updateQuantity(itemId, 1); // Pass the correct values
    });

    // Decrease Quantity
    $(document).on("click", ".decrease", function () {
        updateQuantity($(this).closest("tr").data("id"), -1);
    });

    // Remove Item
    $(document).on("click", ".remove-item", function () {
        removeFromCart($(this).closest("tr").data("id"));
    });

    function updateQuantity(itemId, change) {

        $.ajax({
            url: "/Customer/UpdateQuantity",
            method: "POST",
            data: { ItemID: itemId, Change: change },
            success: function (response) {
                if (!response.sessionAvailable) {
                    let cart = JSON.parse(localStorage.getItem("cart")) || [];
                    let item = cart.find(p => String(p.ItemID) === String(itemId));

                    if (item) {

                        let stockHandler = item.ItemQuantity;
                        stockHandler = (stockHandler + change);

                        if ((stockHandler) > item.StockQuantity) {

                            alert("There is no this in stock");
                        }
                        else
                        {
                            item.ItemQuantity += change; // Ensure correct property name

                            if (item.ItemQuantity <= 0) {
                                cart = cart.filter(p => String(p.ItemID) !== String(itemId));
                            }

                            localStorage.setItem("cart", JSON.stringify(cart));
                        }

                    }
                }

                loadCart(); // Reload UI after update
            },
            error: function (xhr, status, error) {
                console.error("AJAX Request Failed:", status, error);
            }
        });
    }

    function removeFromCart(itemId) {
        $.ajax({
            url: "/Customer/RemoveItem",
            method: "POST",
            data: { ItemID: itemId },
            success: function (response) {
                if (!response.sessionAvailable) {
                    let cart = JSON.parse(localStorage.getItem("cart")) || [];

                    cart = cart.filter(p => String(p.ItemID) !== String(itemId)); // Ensure proper ID comparison

                    localStorage.setItem("cart", JSON.stringify(cart));
                }

                loadCart(); // Reload UI
            },
            error: function (xhr, status, error) {
                console.error("AJAX Request Failed:", status, error);
            }
        });
    }

    function updateCartCount() {
        $.ajax({
            url: "/Customer/GetCartCount",
            type: "GET",
            dataType: "json",
            success: function (response) {
                if (response.success) {
                    $("#cart-count").text(response.count); // Update cart count from DB
                } else {
                    let localCart = JSON.parse(localStorage.getItem("cart")) || [];
                    $("#cart-count").text(localCart.length); // Get cart count from local storage
                }
            },
            error: function () {
                console.log("Error fetching cart count.");
            }
        });
    }

    function LoadProducts() {
        $.ajax({
            type: "GET",
            url: '/StoreHandler/GetAll_Products_Load',
            success: function (ProductsList) {
                $("#productsContainer").empty(); // Clear existing products

                for (var i = 0; i < ProductsList.length; i++) {
                    var product = ProductsList[i];

                    var card = `
                    <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                        <div class="card shadow-sm border-0">
                            <img src="${product.Item_Image1}" class="card-img-top" style="height: 200px; object-fit: cover;" alt="Product Image">
                            <div class="card-body text-center">
                                <h5 class="card-title text-primary">${product.ItemName}</h5>
                                <p class="card-text text-muted">Rs.${product.Item_Price} - Stock: ${product.ItemQuantity}</p>
                                <div class="d-flex justify-content-around">
                                    <button class="btn btn-success btn-sm" onclick="AddToCart(${product.ItemID})">
                                        <i class="fas fa-cart-plus"></i> Add to Cart
                                    </button>
                                    <button class="btn btn-info btn-sm" data-toggle='modal' data-target='#Modal_AddtoCart' onclick="ViewProduct(${product.ItemID})">
                                        <i class="fas fa-eye"></i> View
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                    $("#productsContainer").append(card);
                }
            },
            error: function () {
                alert("Failed to load products.");
            }
        });
    }

    // Add to Cart
    function AddToCart(productId) {
        $.ajax({
            type: "POST",
            url: "/Customer/AddToCart",
            data: '{ProductId :"' + productId + '"}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                alert(response.message);

                if (response.success && response.localStorageData) {
                    let cart = JSON.parse(localStorage.getItem("cart")) || [];

                    // Check if the item already exists in the cart
                    let existingItemIndex = cart.findIndex(item => item.ItemID === response.localStorageData.ItemID);

                    if (existingItemIndex !== -1) {
                        // If item exists, increase the quantity
                        cart[existingItemIndex].ItemQuantity += 1;
                    } else {
                        // Otherwise, add new item to cart
                        cart.push(response.localStorageData);
                    }

                    // Save updated cart to localStorage
                    localStorage.setItem("cart", JSON.stringify(cart));
                    updateCartCount();
                }
                updateCartCount();
            },
            failure: function (r) {
                $.notify("Emp Number Data Loading Error", "error");

            },
            error: function (r) {
                $.notify("Emp Number Data Loading Error", "error");

            }
        })
    }

    function ViewProduct(productId) {
        alert("Viewing details for product " + productId);
    }

    //filter

</script>



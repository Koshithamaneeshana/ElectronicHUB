
@{
    Layout = null;
}


<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />

</head>
<body>

    <style>
        table {
            width: 100%; /* Optional */
            border-collapse: collapse; /* Optional for cleaner table */
        }

        th, td {
            text-align: center;
            vertical-align: middle; /* Ensures text is vertically centered */
            padding: 8px; /* Adds padding for better spacing */
        }
    </style>

    <div>
        <div class="col-md-12">
            <div>
                <div class="panel panel-danger">
                    <div class="panel-heading">
                        <h3 class="panel-title">Awaiting Shipment COD</h3>
                        <input type="text" class="form-control pull-right" id="dev-table-filter" data-action="filter" data-filters="#table_COD_Data" placeholder="Filter" />
                    </div>
                    <table class="table table-hover" id="table_COD_Data">
                        <thead>
                            <tr>
                                <th class="center">Order ID</th>
                                <th class="center">User ID</th>
                                <th class="center">Addres</th>
                                <th class="center">Status</th>
                                <th class="center">Date</th>
                                <th class="center">Sub_Total]</th>
                                <th class="center">Paymet_Type</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
    <br /><br />

    <!-- View Items Modal -->
    <div class="modal fade" id="Modal_Load_Ordered_Items" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Order Items</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="orderItemsContent">
                        <!-- Items will be loaded here dynamically -->
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Update Tracking Modal -->
    <div class="modal fade" id="Modal_Update_Tracking" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header bg-warning text-white">
                    <h5 class="modal-title">Update Tracking Number</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-3"></div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TrackingNumber">Tracking Number</label>
                                <input type="text" class="form-control" id="TrackingNumber" placeholder="Enter Tracking Number" required />
                            </div>
                        </div>
                        <div class="col-md-3"></div>
                    </div>
                    <form id="updateTrackingForm">
                        <input type="hidden" id="Order_ID" />
                        <div class="form-group text-center">
                            <button type="button" class="btn btn-success" onclick="UpdateTracking()">Update Tracking</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


</body>

</html>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<script>

    GetAll_Avaiting_COD_Load();

    function GetAll_Avaiting_COD_Load() {
        $.ajax({
            type: "GET",
            url: '/StoreHandler/GetAll_Avaiting_COD_Load',
            success: function (CODList) {
                $("#table_COD_Data tbody").empty();
                var SetData = $("#table_COD_Data tbody");
                for (var i = 0; i < CODList.length; i++) {
                    var Data = "<tr class='row_" + CODList[i].Order_ID + "'>" +
                        "<td>" + CODList[i].Order_ID + "</td>" +
                        "<td>" + CODList[i].UserId + "</td>" +
                        "<td>" + CODList[i].Address + "</td>" +
                        "<td>" + CODList[i].Status + "</td>" +
                        "<td>" + CODList[i].Date + "</td>" +
                        "<td>" + CODList[i].Sub_Total + "</td>" +
                        "<td>" + CODList[i].Paymet_Type + "</td>" +
                        "<td class='center'>" + "<a href='#' class='btn btn-warning' data-toggle='modal' data-target='#Modal_Update_Tracking' onclick='Edit_Update_Tracking(" + CODList[i].Order_ID + ")' ><span class='glyphicon glyphicon-edit'></span> Update Tracking </a>" + "</td>" +
                        "<td class='center'>" + "<a href='#' class='btn btn-success' data-toggle='modal' data-target='#Modal_Load_Ordered_Items' onclick='Load_Items_In_Customer_Order(" + CODList[i].Order_ID + ", \"" + CODList[i].Paymet_Type + "\")' >" + "<span class='glyphicon glyphicon-edit'></span> View Items </a>" + "</td>"
                        "</tr>";

                    SetData.append(Data);
                }
            },
            error: function (error) {
                $.notify(error);
            }
        });
    }

    function Load_Items_In_Customer_Order(orderId, paymentType) {
        $.ajax({
            type: "GET",
            url: '/StoreHandler/GetOrderItems',
            data: { orderId: orderId },
            success: function (items) {
                var itemContent = "<table class='table table-bordered'><thead><tr><th>Item Name</th><th>Quantity</th><th>Unit Price</th><th>Total</th></tr></thead><tbody>";
                var totalAmount = 0;

                // Iterate over each item and calculate the total amount
                for (var i = 0; i < items.length; i++) {
                    var totalPrice = items[i].Quantity * items[i].Unit_price;
                    totalAmount += totalPrice;

                    itemContent += "<tr>" +
                        "<td>" + items[i].ItemName + "</td>" +
                        "<td>" + items[i].Quantity + "</td>" +
                        "<td>" + items[i].Unit_price + "</td>" +
                        "<td>" + totalPrice.toFixed(2) + "</td>" +
                        "</tr>";
                }

                // Add shipping fee based on Payment_Type (COD or other)
                var shippingFee = (paymentType === 'COD') ? 400 : 350;
                totalAmount += shippingFee;

                // Add shipping fee to the table display
                itemContent += "<tr><td colspan='3' class='text-right'><strong>Shipping Fee:</strong></td><td>" + shippingFee.toFixed(2) + "</td></tr>";
                itemContent += "<tr><td colspan='3' class='text-right'><strong>Total:</strong></td><td><strong>" + totalAmount.toFixed(2) + "</strong></td></tr></tbody></table>";

                $('#orderItemsContent').html(itemContent);
            },
            error: function (error) {
                $.notify(error);
            }
        });
    }

    function UpdateTracking() {

        var orderId = $('#Order_ID').val();
        var trackingNumber = $('#TrackingNumber').val();

        $.ajax({
            type: "POST",
            url: '/StoreHandler/UpdateTrackingNumber',
            data: { orderId: orderId, trackingNumber: trackingNumber },
            success: function (response) {
                if (response.success) {
                    $.notify('Tracking number updated successfully!', { type: 'success' });
                    $('#Modal_Update_Tracking').modal('hide');  // Close the modal
                    // Optionally reload the data to reflect the change
                    GetAll_Avaiting_COD_Load();  // Reload the orders table
                } else {
                    $.notify('Failed to update tracking number. Please try again.', { type: 'danger' });
                }
            },
            error: function (error) {
                $.notify(error);
            }
        });
    }

    function Edit_Update_Tracking(orderId) {
        $('#Order_ID').val(orderId);  // Set the Order ID in the hidden field
    }

</script>



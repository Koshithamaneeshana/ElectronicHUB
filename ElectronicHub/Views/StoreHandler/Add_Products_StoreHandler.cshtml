    function AddItemData() {
        // Clear previous errors
        $(".error-message").remove();

        let isValid = true;

        // Get input values
        let itemID = $('#Item_Code').val().trim();
        let itemName = $('#Item_Name').val().trim();
        let itemQty = $('#Item_Qty').val().trim();
        let itemPrice = $('#Item_Price').val().trim();
        let itemDesc = $('#Item_Description').val().trim();
        let itemStockLimit = $('#Item_Stock_limit').val().trim();

        // Regular expressions for validation
        let numberRegex = /^[0-9]+$/;
        let priceRegex = /^[0-9]+(\.[0-9]{1,2})?$/; // Allows decimals

        // Validation checks
        if (itemID === "") {
            showError("#Item_Code", "Item Code is required.");
            isValid = false;
        }

        if (itemName === "") {
            showError("#Item_Name", "Item Name is required.");
            isValid = false;
        }

        if (itemQty === "" || !numberRegex.test(itemQty) || parseInt(itemQty) <= 0) {
            showError("#Item_Qty", "Enter a valid positive quantity.");
            isValid = false;
        }

        if (itemPrice === "" || !priceRegex.test(itemPrice) || parseFloat(itemPrice) <= 0) {
            showError("#Item_Price", "Enter a valid positive price.");
            isValid = false;
        }

        if (itemDesc === "") {
            showError("#Item_Description", "Item Description is required.");
            isValid = false;
        }

        if (itemStockLimit === "" || !numberRegex.test(itemStockLimit) || parseInt(itemStockLimit) <= 0) {
            showError("#Item_Stock_limit", "Enter a valid positive stock limit.");
            isValid = false;
        }

        // Stop if validation fails
        if (!isValid) {
            return;
        }

        // Prepare form data
        var formData = new FormData();
        formData.append("ItemID", itemID);
        formData.append("ItemName", itemName);
        formData.append("ItemQuantity", itemQty);
        formData.append("Item_Price", itemPrice);
        formData.append("Item_Description", itemDesc);
        formData.append("Item_Stock_limit", itemStockLimit);

        // Send AJAX request
        $.ajax({
            type: "POST",
            url: "/StoreHandler/AddItemData",
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                if (response.success) {
                    alert(response.message);
                    location.reload();
                } else {
                    alert("Error: " + response.message);
                }
            },
            error: function () {
                alert("Error while saving data.");
            }
        });
    }

    // Function to show error messages
    function showError(selector, message) {
        $(selector).after(`<span class='error-message' style='color: red;'>${message}</span>`);
    }


</script>
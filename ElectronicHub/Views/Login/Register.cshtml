<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(to right, #0a0f29, #162447); /* Dark tech gradient */
            font-family: Arial, sans-serif;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            background-color: rgba(0, 0, 0, 0.7);
            padding: 30px;
            border-radius: 10px;
            width: 70%;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
        }

        h4 {
            text-align: center;
            color: aliceblue;
            font-size: 42px;
            margin-bottom: 30px;
        }

        .card {
            background: linear-gradient(to right, #0a0f29, #162447); /* Dark tech gradient */
            color: aliceblue;
            margin-bottom: 20px;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
        }

        .form-group label {
            color: aliceblue;
        }

        .form-control {
            background-color: #222;
            border: 1px solid #444;
            color: aliceblue;
            border-radius: 5px;
            padding: 12px;
        }

            .form-control:focus {
                border-color: #6f42c1;
                box-shadow: 0 0 5px rgba(111, 66, 193, 0.6);
            }

        .btn {
            background-color: #6f42c1;
            color: aliceblue;
            padding: 10px 20px;
            border-radius: 5px;
            width: 100%;
            font-size: 16px;
            border: none;
            cursor: pointer;
        }

            .btn:hover {
                background-color: #5a35a1;
            }

        small {
            display: block;
            margin-top: 5px;
        }

        #emailError,
        #passwordStrength,
        #confirmPasswordError {
            color: red;
        }
    </style>
</head>
<body>
    <br /><br />
    <div class="container mt-4">
        <div class="row">
            <!-- Left Side: User Details -->
            <div class="col-md-6">
                <div class="card p-4">
                    <h4>Register New User</h4>
                    <form id="registerForm">
                        <div class="form-group">
                            <label>Username</label>
                            <input type="text" id="Username" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label>First Name</label>
                            <input type="text" id="FirstName" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label>Last Name</label>
                            <input type="text" id="LastName" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" id="Email" class="form-control" required>
                            <small id="emailError" class="font-weight-bold"></small>
                        </div>

                        <div class="form-group">
                            <label>Street Address</label>
                            <input type="text" id="StreetAddress" class="form-control" required>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Right Side: Password and Address -->
            <div class="col-md-6">
                <div class="card p-4">
                    <h4>Set Password</h4>

                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" id="NewPassword" class="form-control" required>
                        <small id="passwordStrength"></small>
                    </div>

                    <div class="form-group">
                        <label>Confirm Password</label>
                        <input type="password" id="ConfirmNewPassword" class="form-control" required>
                        <small id="confirmPasswordError"></small>
                    </div>

                    <div class="form-group">
                        <label>City</label>
                        <input type="text" id="City" class="form-control" required>
                    </div>

                    <div class="form-group">
                        <label>Postal Code</label>
                        <input type="text" id="PostalCode" class="form-control" required>
                    </div>

                    <div class="form-group">
                        <label>Phone</label>
                        <input type="text" id="Phone" class="form-control" required>
                    </div>
                </div>
            </div>

            <button type="button" id="registerBtn" class="btn" disabled>
                <i class="fa fa-user-plus"></i> Register
            </button>
            <br /><br />
            <!-- Option 1: Button acting as a link using onclick -->
            <button type="button" id="registerBtn" class="btn" onclick="location.href='@Url.Action("Login", "Login")'">
                Login
            </button>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            let emailValid = false;
            let passwordValid = false;

            $("#NewPassword, #ConfirmNewPassword").on("keyup", validatePassword);

            // Email Validation via AJAX
            $("#Email").on("keyup", function () {
                var email = $(this).val();
                if (email.length > 3) {
                    $.ajax({
                        url: "@Url.Action("CheckEmail", "Customer")",
                        type: "POST",
                        data: { email: email },
                        success: function (response) {
                            if (!response.isAvailable) {
                                $("#emailError").text("Email already exists").css("color", "red");
                                emailValid = false;
                            } else {
                                $("#emailError").text("Email available").css("color", "green");
                                emailValid = true;
                            }
                            validateForm();
                        }
                    });
                }
            });

            // Validate the entire form
            function validateForm() {
                let allFieldsFilled = true;

                $("#registerForm input").each(function () {
                    if ($(this).prop("required") && $(this).val().trim() === "") {
                        allFieldsFilled = false;
                    }
                });

                let passwordsMatch = $("#NewPassword").val() === $("#ConfirmNewPassword").val();
                let enableButton = allFieldsFilled && emailValid && passwordValid && passwordsMatch;

                $("#registerBtn").prop("disabled", !enableButton);
            }

            $("#registerForm input").on("keyup", function () {
                validateForm();
            });

            function validatePassword() {
                let password = $("#NewPassword").val();
                let confirmPassword = $("#ConfirmNewPassword").val();
                let strengthText = $("#passwordStrength");
                let confirmError = $("#confirmPasswordError");

                // Regex for Medium to Strong password (at least 8 chars, 1 uppercase, 1 number, 1 special char)
                let regex = /^(?=.*[A-Z])(?=.*\d)(?=.*[$!%*?&])[A-Za-z\d$!%*?&]{8,}$/;

                passwordValid = false; // Reset before checking

                if (password.length === 0) {
                    strengthText.text("").css("color", "black");
                } else if (password.length < 8) {
                    strengthText.text("Weak").css("color", "red");
                } else if (regex.test(password)) {
                    strengthText.text("Strong").css("color", "green");
                    passwordValid = true;
                } else {
                    strengthText.text("Medium").css("color", "orange");
                    passwordValid = true;
                }

                // Confirm Password Validation
                if (confirmPassword.length > 0 && password !== confirmPassword) {
                    confirmError.text("Passwords do not match!").css("color", "red");
                } else {
                    confirmError.text("");
                }

                validateForm(); // Call form validation to enable/disable Register button
            }

            $("#registerBtn").on("click", function () {
                var formData = {
                    username: $("#Username").val(),
                    firstName: $("#FirstName").val(),
                    lastName: $("#LastName").val(),
                    email: $("#Email").val(),
                    password: $("#NewPassword").val(),
                    address: $("#StreetAddress").val(),
                    city: $("#City").val(),
                    postalCode: $("#PostalCode").val(),
                    phone: $("#Phone").val()
                };

                $.ajax({
                    url: '@Url.Action("RegisterUser", "Customer")',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        alert(response.message);
                        if (response.success) {
                            window.location.href = "@Url.Action("Index", "Customer")";
                        }
                    }
                });
            });
        });
    </script>
</body>
</html>

<div class="container">
    <div class="row" id="productsContainer">
        <!-- Products will be dynamically loaded here -->
    </div>

    <!-- Cart Modal -->
    <div class="modal fade" id="Modal_Cart_Data">
        <div class="modal-dialog modal-lg">
            <!-- Increased width -->
            <div class="modal-content" style="background-color: #fff; border-radius: 10px; box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);">
                <div class="modal-header" style="background-color: #28a745; color: white;">
                    <h5 class="modal-title">🛒 Your Shopping Cart</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span style="color: white; font-size: 22px;">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <table class="table table-bordered">
                        <thead class="thead-dark">
                            <tr>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Stock</th>
                                <th>Unit Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="cart-items"></tbody>
                    </table>
                    <h5 class="text-right font-weight-bold">Subtotal: <span id="cart-subtotal" class="text-success">$0.00</span></h5>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary btn-lg btn-block" onclick="proceedToCheckout()">
                        🛍️ Proceed with Checkout
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="Modal_View_Items_Details" tabindex="-1" role="dialog" aria-labelledby="ModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" style="background-color:#f8f9fa; border-radius: 10px;">
                <!-- Modal Header -->
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="ModalLabel">Product Details</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body">
                    <div class="container-fluid">
                        <div class="row">
                            <!-- Product Images -->
                            <div class="col-md-6">
                                <div id="productCarousel" class="carousel slide" data-ride="carousel">
                                    <div class="carousel-inner">
                                        <div class="carousel-item active">
                                            <img id="itemImage1" class="d-block w-100 rounded" src="" alt="Product Image">
                                        </div>
                                        <div class="carousel-item">
                                            <img id="itemImage2" class="d-block w-100 rounded" src="" alt="Product Image">
                                        </div>
                                        <div class="carousel-item">
                                            <img id="itemImage3" class="d-block w-100 rounded" src="" alt="Product Image">
                                        </div>
                                    </div>
                                    <a class="carousel-control-prev" href="#productCarousel" role="button" data-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="sr-only">Previous</span>
                                    </a>
                                    <a class="carousel-control-next" href="#productCarousel" role="button" data-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="sr-only">Next</span>
                                    </a>
                                </div>
                            </div>

                            <!-- Product Details -->
                            <div class="col-md-6">
                                <h4 id="itemName" class="text-primary"></h4>
                                <h5 id="itemPrice" class="text-danger font-weight-bold"></h5>
                                <p id="itemDescription" class="text-muted"></p>
                                <p><strong>Stock Available:</strong> <span id="itemQuantity"></span></p>

                                <!-- Add to Cart Button -->
                                <button class="btn btn-success btn-lg btn-block mt-3" id="addToCartBtn">
                                    <i class="fas fa-cart-plus"></i> Add to Cart
                                </button>
                            </div>
                        </div>

                        <!-- Star Rating & Comments Section -->
                        <div class="mt-3">
                            <h5>Customer Ratings</h5>
                            <div id="starRating"></div>
                        </div>

                        <div class="mt-3">
                            <div id="commentsSection"></div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                @*<div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>*@
            </div>
        </div>
    </div>


</div>


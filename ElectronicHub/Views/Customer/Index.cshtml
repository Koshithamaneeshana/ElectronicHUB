<style>
    .component {
        position: absolute;
        width: 20px; /* Smaller component size */
        height: 20px;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        opacity: 0;
        user-select: none;
        animation: fadeInOut 3s linear infinite, moveAround 4s infinite ease-in-out alternate;
    }

    /* Fade-in and fade-out animation */
    @@keyframes fadeInOut {
        0% {
            opacity: 0;
            transform: scale(0.5);
        }

        10% {
            opacity: 1;
            transform: scale(1);
        }

        90% {
            opacity: 1;
            transform: scale(1);
        }

        100% {
            opacity: 0;
            transform: scale(0.5);
        }
    }

    /* Random movement animation */
    @@keyframes moveAround {
        0% {
            transform: translate(0, 0) rotate(0deg);
        }

        25% {
            transform: translate(40px, 60px) rotate(15deg);
        }

        50% {
            transform: translate(-50px, -40px) rotate(-10deg);
        }

        75% {
            transform: translate(60px, -30px) rotate(20deg);
        }

        100% {
            transform: translate(0, 0) rotate(0deg);
        }
    }

    /* AI Assistant Icon Styles */
    .ai-assistant-icon {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background-color: #007bff;
        color: white;
        border-radius: 50%;
        padding: 15px;
        cursor: pointer;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
        transition: background-color 0.3s ease;
    }

        .ai-assistant-icon:hover {
            background-color: #0056b3;
        }
</style>


    // Function to Generate Star Rating
    function getStars(rating) {
        let stars = "";
        for (let i = 1; i <= 5; i++) {
            stars += i <= rating ? `<i class="fas fa-star text-warning"></i>` : `<i class="far fa-star text-warning"></i>`;
        }
        return stars;
    }



    //filter

    //AI Chat bOT Start

    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("openChat").addEventListener("click", function () {
            let chatWindow = document.getElementById("chatWindow");
            chatWindow.style.display = chatWindow.style.display === "block" ? "none" : "block";
            loadPreviousChats(); // Load previous chats when opening the chat
        });

        document.getElementById("closeChat").addEventListener("click", function () {
            document.getElementById("chatWindow").style.display = "none";
        });

        document.getElementById("userInput").addEventListener("keypress", function (event) {
            if (event.key === "Enter") {
                sendMessage();
            }
        });
    });

    function sendMessage() {
        let userMessage = document.getElementById("userInput").value.trim();
        if (!userMessage) return;

        let chatBox = document.getElementById("chatMessages");

        // Append User Message
        let userMsgElement = document.createElement("div");
        userMsgElement.classList.add("message", "user");
        userMsgElement.innerHTML = `<strong>User:</strong> ${userMessage}`;
        chatBox.appendChild(userMsgElement);
        document.getElementById("userInput").value = "";
        scrollToBottom();

        // Send to backend and fetch AI response
        fetch("/AIassistant/GetResponse", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ Message: userMessage }),
        })
            .then(response => response.json())
            .then(data => {
                let aiMsgElement = document.createElement("div");
                aiMsgElement.classList.add("message", "ai");
                aiMsgElement.innerHTML = `<strong>AI:</strong> ${data}`;
                chatBox.appendChild(aiMsgElement);
                scrollToBottom();
            })
            .catch(() => {
                chatBox.innerHTML += "<div class='error'>Error fetching AI response.</div>";
            });
    }

    function scrollToBottom() {
        let chatBox = document.getElementById("chatMessages");
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    function loadPreviousChats() {
        fetch("/AIassistant/GetPreviousChats")
            .then(response => response.json())
            .then(chats => {
                let chatBox = document.getElementById("chatMessages");
                chatBox.innerHTML = ""; // Clear previous messages
                if (chats.length === 0) {
                    chatBox.innerHTML = "<div class='no-chats'>No previous chats found.</div>";
                } else {
                    chats.forEach(chat => {
                        let userMsgElement = document.createElement("div");
                        userMsgElement.classList.add("chat-bubble", "user-bubble");
                        userMsgElement.innerHTML = `<strong>You:</strong> ${chat.UserMessage}`;
                        chatBox.appendChild(userMsgElement);

                        let aiMsgElement = document.createElement("div");
                        aiMsgElement.classList.add("chat-bubble", "ai-bubble");
                        aiMsgElement.innerHTML = `<strong>AI:</strong> ${chat.AIResponse}`;
                        chatBox.appendChild(aiMsgElement);
                    });
                }
                scrollToBottom();
            })
            .catch(() => {
                document.getElementById("chatMessages").innerHTML = "<div class='error-bubble'>Failed to load previous chats.</div>";
            });
    }

    //AI ChatBOT End


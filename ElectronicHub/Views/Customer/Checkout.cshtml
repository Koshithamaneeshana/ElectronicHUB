        //cOFIRM Order

        function placeOrder() {
            let selectedPayment = document.querySelector('input[name="paymentMethod"]:checked');

            if (!selectedPayment) {
                alert("⚠️ Please select a payment method before placing the order.");
                return;
            }

            let paymentMethod = selectedPayment.id; // Get selected payment method (cashOnDelivery or paypal)
            let totalAmount = parseFloat(document.getElementById("total-price").textContent.replace("Rs.", "").trim()) || 0;

            // full address
            let firstName = document.getElementById("first-name").value.trim();
            let lastName = document.getElementById("last-name").value.trim();
            let streetAddress = document.getElementById("street-address").value.trim();
            let city = document.getElementById("city").value.trim();
            let postalCode = document.getElementById("postal-code").value.trim();
            let email = document.getElementById("email").value.trim();

            let fullAddress = `${firstName}, ${lastName}, ${streetAddress}, ${city}, ${postalCode}, ${email}`;

            // Extract cart items from table rows
            let cartItems = [];

            document.querySelectorAll("#cart-items-checkout tr").forEach(row => {
                let itemID = row.getAttribute("data-id"); // Extract item ID from data-id attribute

                // Ensure row has required structure before extracting data
                let nameCell = row.querySelector(".cart-item-name");
                let priceCell = row.querySelector(".cart-item-price");
                let quantityCell = row.querySelector(".cart-item-quantity span");

                if (nameCell && priceCell && quantityCell) {

                    let name = nameCell.textContent.trim();
                    let unitPrice = priceCell.textContent.replace("Rs.", "");
                    let quantity = quantityCell.textContent.trim();

                    cartItems.push({ itemID, name, unitPrice, quantity });

                } else {

                    alert("Row structure missing required elements", row);

                }
            });

            if (cartItems.length === 0) {
                alert("⚠️ Your cart is empty. Please add items before placing an order.");
                return;
            }

            if (paymentMethod === "cashOnDelivery") {
                // Show confirmation message
                let confirmCOD = confirm(`You will receive your order within 1-2 days.
You have to pay COD amount: Rs.${totalAmount}. Are you sure you want to proceed with COD?`);

                if (confirmCOD) {
                    // Send AJAX request
                    $.ajax({
                        type: "POST",
                        url: "/Customer/ProcessOrder",
                        contentType: "application/json",
                        data: JSON.stringify({
                            paymentMethod: "COD",
                            totalAmount: totalAmount,
                            cartItems: JSON.stringify(cartItems),
                            fullAddress: fullAddress
                        }),
                        success: function (response) {
                            alert("✅ Order placed successfully with Cash on Delivery!");
                            //window.location.href = = '@Url.Action("Index", "Customer")';
                        },
                        error: function () {
                            alert("❌ Failed to place order. Please try again.");
                        }
                    });
                }
            } else if (paymentMethod === "paypal") {
                // Open PayPal modal
                $("#paypalModal").modal("show");
            }
        }


        // Extract cart items from table rows
        function extractCartItems() {
            let cartItemsExtracted = [];

            document.querySelectorAll("#cart-items-checkout-test tr").forEach(row => {
                let itemID = row.getAttribute("data-id"); // Extract item ID from data-id attribute

                // Ensure row has required structure before extracting data
                let nameCell = row.querySelector(".cart-item-name");
                let priceCell = row.querySelector(".cart-item-price");
                let quantityCell = row.querySelector(".cart-item-quantity span");

                if (nameCell && priceCell && quantityCell) {

                    let name = nameCell.textContent.trim();
                    let unitPrice = priceCell.textContent.replace("Rs.", "");
                    let quantity = quantityCell.textContent.trim();

                    cartItemsExtracted.push({ itemID, name, unitPrice, quantity });

                } else {

                    alert("Row structure missing required elements", row);

                }
            });

            // Debugging Output
            alert(cartItemsExtracted);

            return cartItemsExtracted;
        }

    </script>

        margin-bottom: 15px;
    }

    .payment-option {
        display: flex;
        align-items: center;
        font-size: 16px;
        margin-top: 10px;
    }

        .payment-option i {
            font-size: 22px;
            margin-right: 10px;
            color: #0070ba; /* PayPal Blue */
        }

    #cashOnDelivery + label i {
        color: #28a745; /* Green for Cash on Delivery */
    }
</style>

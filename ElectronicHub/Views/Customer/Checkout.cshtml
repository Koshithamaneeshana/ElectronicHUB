        function togglePayment(method) {

            let baseTotal = parseFloat(document.getElementById("total-price").getAttribute("data-base-price"));

            alert(baseTotal)
            let totalPriceElement = document.getElementById("total-price");
            let shippingCostElement = document.getElementById("shipping-cost");
            let placeOrderBtn = document.getElementById("placeOrderBtn");
            let errorMessageDiv = document.getElementById("error-message");

            let newTotal = baseTotal; // Reset total price

            if (method === "cod") {
                newTotal += 400;
                shippingCostElement.innerHTML = "<span class='fw-bold text-danger'>Rs.400</span>"; // Update shipping cost
            } else if (method === "paypal") {
                newTotal += 350;
                shippingCostElement.innerHTML = "<span class='fw-bold text-success'>Free</span>"; // Keep shipping free
            }

            // Update total price
            totalPriceElement.innerHTML = `Rs.${newTotal.toFixed(2)}`;

            // Validate form fields before enabling the button
            let requiredFields = ["first-name", "last-name", "street-address", "city", "postal-code", "email"];
            let isValid = true;
            let errorMessage = "<strong>Please fill out the required fields:</strong><ul class='mb-0'>";

            requiredFields.forEach(function (field) {
                let input = document.getElementById(field);
                if (!input.value.trim()) {
                    isValid = false;
                    errorMessage += `<li>${input.previousElementSibling.innerText}</li>`;
                    input.classList.add("is-invalid"); // Highlight empty fields
                } else {
                    input.classList.remove("is-invalid");
                }
            });

            if (isValid) {
                // Hide the error message if validation passes
                errorMessageDiv.innerHTML = "";
                errorMessageDiv.style.display = "none";

                // Enable the Place Order button and remove lock icon
                placeOrderBtn.removeAttribute("disabled");
                placeOrderBtn.innerHTML = '<i class="fas fa-check-circle"></i> Place Order';
            } else {
                // Show a confirmation message for login or guest checkout
                let userChoice = confirm(`⚠️ You have not logged into the system.
                                            If you already have an account, do you want to go to the Sign-In page?
                                            If you don't have an account, do you wish to place an order as a guest?
                                            Your billing details will be saved as account details.`);

                if (userChoice) {
                    window.location.href = "/login"; // Redirect to login page
                    return;
                }

                // Show the validation message if they choose guest checkout
                errorMessage += "</ul>";
                errorMessageDiv.innerHTML = `<div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    ${errorMessage}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>`;
                errorMessageDiv.style.display = "block";

                // Disable the button and add lock icon
                placeOrderBtn.setAttribute("disabled", "true");
                placeOrderBtn.innerHTML = '<i class="fas fa-lock"></i> Place Order';
            }
        }



        function updateTotalPrice() {

            let totalPriceElement = document.getElementById("total-price");
          
            if (totalPriceElement) {

                let priceText = totalPriceElement.textContent.trim();


                if (priceText === "Rs.0.00" || priceText === "Rs. 0.00" || priceText === "0.00") {
                    console.warn("⚠️ Price not updated yet! Retrying...");
                    setTimeout(updateTotalPrice, 500); // Retry after 500ms
                    return;
                }

                // Remove "Rs." and extra spaces, then extract correct decimal value
                let cleanedPrice = priceText.replace(/[^0-9.]/g, ''); // Keep only numbers and '.'

                // Ensure only the first decimal point remains
                let finalPrice = parseFloat(priceText.replace("Rs.", ""))
                //let finalPrice = cleanedPrice.replace(/(\..*)\./g, '$1'); // Removes extra decimals if present

                let basePrice = parseFloat(finalPrice) || 0;

                //console.log("🔍 Raw Price Text:", priceText);
                //console.log("✅ Corrected Extracted Price:", finalPrice);

                // Store the extracted value
                totalPriceElement.setAttribute("data-base-price", finalPrice);
            }
        }

        // Run after the page loads
        document.addEventListener("DOMContentLoaded", function () {
            setTimeout(updateTotalPrice, 500);
        });



        // Load Cart Data from DB or Local Storage
        function loadCart() {
            $.ajax({
                url: "/Customer/GetCartItems",
                method: "GET",
                success: function (response) {
                    if (response.sessionAvailable) {
                        renderCart(response.data);
                    } else {
                        // Load from localStorage
                        let localCart = JSON.parse(localStorage.getItem("cart")) || [];

                        if (localCart.length > 0) {
                            // Fetch images for localStorage items using ItemID
                            let itemIds = localCart.map(item => item.ItemID);

                            $.post("/Customer/GetImagesForItems", { itemIds: itemIds })
                                .done(function (imageResponse) {

                                    localCart.forEach(item => {

                                        // Convert both to string for safe comparison
                                        let matchedImage = imageResponse.find(img => String(img.ItemID) === String(item.ItemID));

                                        if (matchedImage) {
                                            item.Item_Image1 = matchedImage.Item_Image1; // Assign image correctly
                                        } else {
                                            console.warn("No image found for ItemID:", item.ItemID);
                                            item.Item_Image1 = "default.jpg"; // Fallback image
                                        }
                                    });

                                    console.log("Final Cart Data Before Render:", localCart); // Check before rendering

                                    renderCart(localCart);
                                })
                                .fail(function (xhr, status, error) {
                                    console.error("AJAX Request Failed:", status, error);
                                });

                        } else {

                            renderCart([]);
                        }
                    }
                }
            });
        }

        // Render Cart Items
        function renderCart(cartItems) {
            let cartTable = $("#cart-items-checkout");
            cartTable.empty();
            let subtotal = 0;

            cartItems.forEach(item => {
                let itemTotal = item.Item_Price * item.ItemQuantity;
                subtotal += itemTotal;
                cartTable.append(`
                <tr data-id="${item.ItemID}">
                    <td><img src="${item.Item_Image1}" width="80" height="80" ></td>
                    <td class="cart-item-name" >${item.ItemName}</td>
                    <td data-stock="${item.StockQuantity}">${item.StockQuantity}</td>
                    <td class="cart-item-price" >Rs.${item.Item_Price}</td>
                    <td class="cart-item-quantity" >
                        <button class="btn btn-sm btn-light decrease">-</button>
                        <span class="px-2" data-ItemQuantity="${item.ItemQuantity}">${item.ItemQuantity}</span>
                        <button class="btn btn-sm btn-light increase">+</button>
                    </td>
                    <td>Rs.${itemTotal.toFixed(2) }</td>
                    <td><button class="btn btn-danger btn-sm remove-item">X</button></td>
                </tr>
            `);
            });

            $("#cart-subtotal").text(`Rs.${subtotal.toFixed(2)}`);
            $("#total-price").text(`Rs.${subtotal.toFixed(2)}`);
            $("#cart-count").text(cartItems.length);
        }

        // Increase Quantity
        $(document).on("click", ".increase", function () {
            updateQuantity($(this).closest("tr").data("id"), 1);
           Reset_Payement_Method();
        });

        // Decrease Quantity
        $(document).on("click", ".decrease", function () {
            updateQuantity($(this).closest("tr").data("id"), -1);
            Reset_Payement_Method();
        });

        // Remove Item
        $(document).on("click", ".remove-item", function () {
            removeFromCart($(this).closest("tr").data("id"));
            Reset_Payement_Method();
        });


        function updateQuantity(itemId, change) {
            $.ajax({
                url: "/Customer/UpdateQuantity",
                method: "POST",
                data: { ItemID: itemId, Change: change },
                success: function (response) {
                    if (!response.sessionAvailable) {
                        let cart = JSON.parse(localStorage.getItem("cart")) || [];
                        let item = cart.find(p => String(p.ItemID) === String(itemId));

                        if (item) {
                            //item.ItemQuantity += change; // Ensure correct property name

                            //if (item.ItemQuantity <= 0) {
                            //    cart = cart.filter(p => String(p.ItemID) !== String(itemId));
                            //}

                            //localStorage.setItem("cart", JSON.stringify(cart));

                            let stockHandler = item.ItemQuantity;
                            stockHandler = (stockHandler + change);

                            if ((stockHandler) > item.StockQuantity) {

                                alert("There is no this in stock");
                            }
                            else {
                                item.ItemQuantity += change; // Ensure correct property name

                                if (item.ItemQuantity <= 0) {
                                    cart = cart.filter(p => String(p.ItemID) !== String(itemId));
                                }

                                localStorage.setItem("cart", JSON.stringify(cart));
                            }
                        }
                    }

                    loadCart(); // Reload UI after update
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Request Failed:", status, error);
                }
            });
        }

        function removeFromCart(itemId) {
            $.ajax({
                url: "/Customer/RemoveItem",
                method: "POST",
                data: { ItemID: itemId },
                success: function (response) {
                    if (!response.sessionAvailable) {
                        let cart = JSON.parse(localStorage.getItem("cart")) || [];

                        cart = cart.filter(p => String(p.ItemID) !== String(itemId)); // Ensure proper ID comparison

                        localStorage.setItem("cart", JSON.stringify(cart));
                    }


                    loadCart(); // Reload UI
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Request Failed:", status, error);
                }
            });
        }

        function updateCartCount() {
            $.ajax({
                url: "/Customer/GetCartCount",
                type: "GET",
                dataType: "json",
                success: function (response) {
                    if (response.success) {
                        $("#cart-count").text(response.count); // Update cart count from DB
                    } else {
                        let localCart = JSON.parse(localStorage.getItem("cart")) || [];
                        $("#cart-count").text(localCart.length); // Get cart count from local storage
                    }
                },
                error: function () {
                    console.log("Error fetching cart count.");
                }
            });
        }


        function Reset_Payement_Method() {

            updateTotalPrice();

            //let selectedPayment = document.querySelector('input[name="paymentMethod"]:checked');

            //if (selectedPayment) {
            //    selectedPayment.checked = false; // Uncheck the selected payment method
            //}

<div class="container">

    <!-- Order Summary -->
    <div class="mt-3">
        <h5 class="mb-3">🛒 Checkout Page</h5>
        <table class="table table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Unit Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="cart-items-checkout">
                <!-- Cart items will be loaded dynamically -->
            </tbody>
        </table>
        <h5 class="text-right font-weight-bold">Subtotal: <span id="cart-subtotal" class="text-success">$0.00</span></h5>
    </div>

    <div class="row">
        <!-- Billing Details -->
        <div class="col-md-6">
            <h5>Billing Details</h5>
            <form id="checkout-form">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">First Name *</label>
                        <input type="text" class="form-control" id="first-name" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Last Name *</label>
                        <input type="text" class="form-control" id="last-name" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Street Address *</label>
                    <input type="text" class="form-control" id="street-address" required>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">City *</label>
                        <input type="text" class="form-control" id="city" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Postal Code *</label>
                        <input type="text" class="form-control" id="postal-code" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email Address *</label>
                    <input type="email" class="form-control" id="email" required>
                </div>
            </form>
        </div>

            <!-- Order Summary -->
        <div class="col-md-6">
            <h5 class="mb-3"><i class="fas fa-receipt"></i> Order Summary</h5>
            <div class="order-summary border p-3 rounded shadow-sm bg-light">
                <ul id="cart-summary" class="list-group mb-3"></ul>

                <div class="d-flex justify-content-between">
                    <span><i class="fas fa-shipping-fast"></i> Shipping:</span>
                    <span class="fw-bold text-success">Free</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span><i class="fas fa-calculator"></i> Estimated Tax:</span>
                    <span class="fw-bold">$0.00</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between">
                    <h5 class="fw-bold text-danger">Total:</h5>
                    <h5 id="total-price" class="fw-bold text-danger">$0.00</h5>
                </div>
            </div>
            <div class="payment-container">
                <h5 class="payment-title"><i class="fas fa-credit-card"></i> Payment Method</h5>
                <div class="payment-methods">
                    <label class="form-label fw-bold">Choose Payment Method:</label>
                    <div class="form-check payment-option">
                        <input type="radio" id="cashOnDelivery" name="paymentMethod" class="form-check-input" onclick="togglePayment('cod')">
                        <label for="cashOnDelivery" class="form-check-label">
                            <i class="fas fa-hand-holding-usd"></i> Cash on Delivery
                        </label>
                    </div>

                    <div class="form-check payment-option">
                        <input type="radio" id="paypal" name="paymentMethod" class="form-check-input" onclick="togglePayment('paypal')">
                        <label for="paypal" class="form-check-label">
                            <i class="fab fa-paypal"></i> PayPal
                        </label>
                    </div>
                </div>
            </div>
            <br />
            <button type="submit" class="btn btn-primary w-100 mt-3">Place Order</button>
        </div>
    </div>
</div>

<script src="~/Content/Jquery/3.5.1/jquery.min.js"></script>

<script>
    $(document).ready(function () {
        updateCartCount();
        loadCart();
    });

    // Ensure only one payment method is selected
    function togglePayment(method) {
        if (method === 'cod') {
            document.getElementById('paypal').checked = false;
        } else {
            document.getElementById('cashOnDelivery').checked = false;
        }
    }
    // Load Cart Data from DB or Local Storage
    function loadCart() {
        $.ajax({
            url: "/Customer/GetCartItems",
            method: "GET",
            success: function (response) {
                if (response.sessionAvailable) {
                    renderCart(response.data);
                } else {
                    // Load from localStorage
                    let localCart = JSON.parse(localStorage.getItem("cart")) || [];

                    if (localCart.length > 0) {
                        // Fetch images for localStorage items using ItemID
                        let itemIds = localCart.map(item => item.ItemID);

                        $.post("/Customer/GetImagesForItems", { itemIds: itemIds })
                            .done(function (imageResponse) {

                                localCart.forEach(item => {

                                    // Convert both to string for safe comparison
                                    let matchedImage = imageResponse.find(img => String(img.ItemID) === String(item.ItemID));

                                    if (matchedImage) {
                                        item.Item_Image1 = matchedImage.Item_Image1; // Assign image correctly
                                    } else {
                                        console.warn("No image found for ItemID:", item.ItemID);
                                        item.Item_Image1 = "default.jpg"; // Fallback image
                                    }
                                });

                                console.log("Final Cart Data Before Render:", localCart); // Check before rendering

                                renderCart(localCart);
                            })
                            .fail(function (xhr, status, error) {
                                console.error("AJAX Request Failed:", status, error);
                            });

                    } else {

                        renderCart([]);
                    }
                }
            }
        });
    }

    // Render Cart Items
    function renderCart(cartItems) {
        let cartTable = $("#cart-items-checkout");
        cartTable.empty();
        let subtotal = 0;

        cartItems.forEach(item => {
            let itemTotal = item.Item_Price * item.ItemQuantity;
            subtotal += itemTotal;
            cartTable.append(`
                <tr data-id="${item.ItemID}">
                    <td><img src="${item.Item_Image1}" width="80" height="80" ></td>
                    <td>${item.ItemName}</td>
                    <td>Rs.${item.Item_Price}</td>
                    <td>
                        <button class="btn btn-sm btn-light decrease">-</button>
                        <span class="px-2">${item.ItemQuantity}</span>
                        <button class="btn btn-sm btn-light increase">+</button>
                    </td>
                    <td>Rs.${itemTotal.toFixed(2)}</td>
                    <td><button class="btn btn-danger btn-sm remove-item">X</button></td>
                </tr>
            `);
        });

        $("#cart-subtotal").text(`Rs.${subtotal.toFixed(2)}`);
        $("#total-price").text(`Rs.${subtotal.toFixed(2)}`);
        $("#cart-count").text(cartItems.length);
    }

        // Increase Quantity
    $(document).on("click", ".increase", function () {
        updateQuantity($(this).closest("tr").data("id"), 1);
    });

    // Decrease Quantity
    $(document).on("click", ".decrease", function () {
        updateQuantity($(this).closest("tr").data("id"), -1);
    });

    // Remove Item
    $(document).on("click", ".remove-item", function () {
        removeFromCart($(this).closest("tr").data("id"));
    });


    function updateQuantity(itemId, change) {
        $.ajax({
            url: "/Customer/UpdateQuantity",
            method: "POST",
            data: { ItemID: itemId, Change: change },
            success: function (response) {
                if (!response.sessionAvailable) {
                    let cart = JSON.parse(localStorage.getItem("cart")) || [];
                    let item = cart.find(p => String(p.ItemID) === String(itemId));

                    if (item) {
                        item.ItemQuantity += change; // Ensure correct property name

                        if (item.ItemQuantity <= 0) {
                            cart = cart.filter(p => String(p.ItemID) !== String(itemId));
                        }

                        localStorage.setItem("cart", JSON.stringify(cart));
                    }
                }

                loadCart(); // Reload UI after update
            },
            error: function (xhr, status, error) {
                console.error("AJAX Request Failed:", status, error);
            }
        });
    }

    function removeFromCart(itemId) {
        $.ajax({
            url: "/Customer/RemoveItem",
            method: "POST",
            data: { ItemID: itemId },
            success: function (response) {
                if (!response.sessionAvailable) {
                    let cart = JSON.parse(localStorage.getItem("cart")) || [];

                    cart = cart.filter(p => String(p.ItemID) !== String(itemId)); // Ensure proper ID comparison

                    localStorage.setItem("cart", JSON.stringify(cart));
                }

                loadCart(); // Reload UI
            },
            error: function (xhr, status, error) {
                console.error("AJAX Request Failed:", status, error);
            }
        });
    }

    function updateCartCount() {
        $.ajax({
            url: "/Customer/GetCartCount",
            type: "GET",
            dataType: "json",
            success: function (response) {
                if (response.success) {
                    $("#cart-count").text(response.count); // Update cart count from DB
                } else {
                    let localCart = JSON.parse(localStorage.getItem("cart")) || [];
                    $("#cart-count").text(localCart.length); // Get cart count from local storage
                }
            },
            error: function () {
                console.log("Error fetching cart count.");
            }
        });
    }


</script>
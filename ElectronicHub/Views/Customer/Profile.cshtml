@{
    Layout = null;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">
<style>
    body {
        background-color: #f8f9fa;
    }

    .dashboard-container {
        display: flex;
        height: 100vh;
    }

    .sidebar {
        width: 250px;
        background-color: #343a40;
        padding: 20px;
        color: white;
        height: 100%;
    }

        .sidebar .nav-link {
            color: white;
            padding: 10px;
            font-size: 18px;
        }

            .sidebar .nav-link.active, .sidebar .nav-link:hover {
                background-color: #495057;
                border-radius: 5px;
            }

    .content-area {
        flex: 1;
        padding: 20px;
        background-color: white;
        border-radius: 10px;
        margin: 20px;
    }

    .profile-img {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 3px solid white;
        display: block;
        margin: 0 auto 10px;
    }

    .tab-content {
        margin-top: 20px;
    }

    .nav-tabs .nav-item {
        flex-grow: 1; /* Makes all tabs equal width */
    }

    .nav-tabs .nav-link {
        width: 100%;
        text-align: center;
        padding: 12px 0; /* Adjust padding for equal height */
    }

    /* Style the tab navigation */
    .custom-tabs {
        width: 100%; /* Make full width */
        border-bottom: 2px solid #444; /* Dark grey bottom border */
        display: flex; /* Align items in a row */
        justify-content: space-around; /* Evenly distribute tabs */
        background-color: #222; /* Dark background */
        padding: 5px 0;
        gap: 15px; /* Adds spacing between tabs */
    }

        /* Style individual tabs */
        .custom-tabs .nav-link {
            color: #ccc !important; /* Light grey text */
            background: linear-gradient(to right, #0a0f29, #162447); /* Dark grey background */
            border: 1px solid #444;
            border-radius: 5px 5px 0 0; /* Rounded top corners */
            padding: 10px 20px;
            text-align: center;
            transition: background 0.3s ease, color 0.3s ease;
        }

            /* Hover effect */
            .custom-tabs .nav-link:hover {
                background-color: #555 !important; /* Medium grey */
                color: white !important;
            }

            /* Active tab style */
            .custom-tabs .nav-link.active {
                background-color: #666 !important; /* Slightly lighter grey */
                font-weight: bold;
                color: white !important;
            }



</style>
<div class="container-lg">
    <nav class="navbar navbar-expand-lg" style="background: linear-gradient(to right, #0a0f29, #162447);">
        <a class="navbar-brand text-white" href="@Url.Action("Index", "Customer")">Electronic HUB</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto">
                <li class="nav-item active">
                    <a class="nav-link text-white" href="#">Blog <span class="sr-only">(current)</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="#">Offers</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdown" role="button"
                       data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        Category
                    </a>
                    <div class="dropdown-menu">
                        <a class="dropdown-item" href="#">Componants</a>
                        <a class="dropdown-item" href="#">Tools</a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="#">PCB</a>
                    </div>
                </li>
            </ul>
            <form class="form-inline my-2 my-lg-0">
                <input id="searchInput" class="form-control mb-6" type="search">
            </form>
            <li class="nav-item dropdown">
                <a href="" id="cart-icon" role="button" data-toggle="modal" data-target="#Modal_Cart_Data" onclick="loadCart()">
                    <i class="fa fa-shopping-cart fa-2xl"></i>
                    <span id="cart-count" class="badge badge-danger">0</span> <!-- Cart count badge -->
                </a>
            </li>
            <li class="nav-item dropdown">
                <a href="@Url.Action("Profile", "Customer")" role="button">
                    <i class="fa fa-user fa-2xl"></i> <!-- Human face icon -->
                </a>
            </li>
            <li class="nav-item dropdown">
                <a href="@Url.Action("Logout", "Login")" role="button"><i class="fa fa-sign-out fa-2xl "></i></a>
            </li>
            <div class="dropdown-menu">
                <a class="dropdown-item" href="#">Action</a>
                <a class="dropdown-item" href="#">Another action</a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="#">Something else here</a>
            </div>
        </div>
    </nav>
</div>
<div class="dashboard-container" style="background: linear-gradient(to right, #0a0f29, #162447);">
    <!-- Sidebar -->
    <div class="sidebar" style="background: linear-gradient(to right, #0a0f29, #162447); border-radius:20px;">
        <img src="~/Resources/user.jpg" alt="User Image" class="profile-img">
        <h4 class="text-center">@Session["name"].ToString()</h4>
        <br />
        <ul class="nav nav-tabs custom-tabs" style="background: linear-gradient(to right, #0a0f29, #162447);">
            <li class="nav-item">
                <a class="nav-link active" data-toggle="tab" href="#firstTab">My Profile</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab" href="#secondTab">My Addresses</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab" href="#thirdTab">My Orders</a>
            </li>
        </ul>


    </div>

    <div class="content-area" >
        <div class="tab-content">
            <div id="firstTab" class="tab-pane fade in active">@Html.Action("User_profile_Handling")</div>
            <div id="secondTab" class="tab-pane fade in">@Html.Action("Addresses_Handling")</div>
            <div id="thirdTab" class="tab-pane fade in">@Html.Action("Orders_Handling")</div>
        </div>
    </div>


    </div>

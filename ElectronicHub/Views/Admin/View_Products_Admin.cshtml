
@{
    Layout = null;
}


<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />

</head>
<body>

    <!-- Model Content Start -->
    <div class="modal fade" id="Modal_Update_Products">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color:#7A7575">
                <!-- Model Content -->
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Update Product Details</h5>
                        <button type="button" class="close order-1" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true" style="color:red;margin: -1rem auto -1rem -1rem;padding: 1rem 1rem">X</span>
                        </button>
                    </div>

                    <div class="modal-body">
                        <div class="row">
                            <div class="form-group col-md-4">
                                <label>Item Name</label>
                                <input type="text" class="form-control" id="ItemName" placeholder="Enter product name" />
                            </div>
                            <div class="form-group col-md-4">
                                <label>Stock Quantity</label>
                                <input type="number" class="form-control" id="ItemQuantity" placeholder="Enter stock quantity" />
                            </div>
                            <div class="form-group col-md-4">
                                <label>Unit Price</label>
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Rs.</span>
                                </div>
                                <input type="number" class="form-control" id="ItemPrice" placeholder="Enter unit price" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group col-md-6">
                                <label for="ItemDescription" class="font-weight-bold">Description</label>
                                <textarea class="form-control" id="ItemDescription" rows="4" placeholder="Enter a short description of the product"></textarea>
                            </div>
                            <div class="form-group col-md-3">
                                <label for="inputStatus">Stock Limit</label>
                                <input type="number" class="form-control" id="ItemStockLimit" placeholder="Enter stock limit" />
                            </div>
                            <div class="col-md-3">
                                <br />

                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3"></div>
                            <div class="col-md-6">

                                <button type="button" class="btn btn-success" onclick="updateProduct()">
                                    <i class="glyphicon glyphicon-save"></i> Update Product
                                </button>
                            </div>
                            <div class="col-md-3"></div>

                        </div>

                    </div>
                    <!-- End Model Content -->
                </div>
            </div>
        </div>
    </div>
    <!-- Model Content End-->

    <div>
        <div class="col-md-12">
            <div>
                <div class="panel panel-danger">
                    <div class="panel-heading">
                        <h3 class="panel-title">Products Data</h3>
                        <input type="text" class="form-control pull-right" id="dev-table-filter" data-action="filter" data-filters="#table_Products_Data" placeholder="Filter" />
                    </div>
                    <table class="table table-hover" id="table_Products_Data">
                        <thead>
                            <tr>
                                <th class="center">Item ID</th>
                                <th class="center">Item Name</th>
                                <th class="center">Stock Quantity</th>
                                <th class="center">Unit Price</th>
                                <th class="center">Description</th>
                                <th class="center">Stock Limt</th>
                                <th class="center">Picture 01</th>
                                <th class="center">Picture 02</th>
                                <th class="center">Picture 03</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
    <br /><br />
</body>

</html>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<script>

    GetAll_Items_Load();

    function GetAll_Items_Load() {
        $.ajax({
            type: "GET",
            url: '/StoreHandler/GetAll_Products_Load',
            success: function (ProductsList) {
                $("#table_Products_Data tbody").empty();
                var SetData = $("#table_Products_Data tbody");
                for (var i = 0; i < ProductsList.length; i++) {

                    if (ProductsList[i].ItemQuantity - ProductsList[i].Item_Stock_limit == 15) {
                        var Data = "<tr class='row_" + ProductsList[i].ID + "'>" +
                            "<td style='background-color: #FFAA33;'>" + ProductsList[i].ItemID + "</td>" +
                            "<td style='background-color: #FFAA33;'>" + ProductsList[i].ItemName + "</td>" +
                            "<td style='background-color: #FFAA33;'>" + ProductsList[i].ItemQuantity + "</td>" +
                            "<td style='background-color: #FFAA33;'>" + ProductsList[i].Item_Price + "</td>" +
                            "<td style='background-color: #FFAA33;'>" + ProductsList[i].Item_Description + "</td>" +
                            "<td style='background-color: #FFAA33;'>" + ProductsList[i].Item_Stock_limit + "</td>" +
                            "<td>" + (ProductsList[i].Item_Image1 ? "<img src='" + ProductsList[i].Item_Image1 + "' width='80' height='80' style='border-radius: 5px;' />" : "No Image") + "</td>" +
                            "<td>" + (ProductsList[i].Item_Image2 ? "<img src='" + ProductsList[i].Item_Image2 + "' width='80' height='80' style='border-radius: 5px;' />" : "No Image") + "</td>" +
                            "<td>" + (ProductsList[i].Item_Image3 ? "<img src='" + ProductsList[i].Item_Image3 + "' width='80' height='80' style='border-radius: 5px;' />" : "No Image") + "</td>" +
                            "<td class='center'>" + "<a href='#' class='btn btn-warning' data-toggle='modal' data-target='#Modal_Update_Products' onclick='Edit_Products(" + ProductsList[i].ID + ")' ><span class='glyphicon glyphicon-edit'></span> Update </a>" + "</td>" +
                            "</tr>";
                    }
                    else if (ProductsList[i].ItemQuantity - ProductsList[i].Item_Stock_limit == 10) {
                        var Data = "<tr class='row_" + ProductsList[i].ID + "'>" +
                            "<td style='background-color: #F10C27;'>" + ProductsList[i].ItemID + "</td>" +
                            "<td style='background-color: #F10C27;'>" + ProductsList[i].ItemName + "</td>" +
                            "<td style='background-color: #F10C27;'>" + ProductsList[i].ItemQuantity + "</td>" +
                            "<td style='background-color: #F10C27;'>" + ProductsList[i].Item_Price + "</td>" +
                            "<td style='background-color: #F10C27;'>" + ProductsList[i].Item_Description + "</td>" +
                            "<td style='background-color: #F10C27;'>" + ProductsList[i].Item_Stock_limit + "</td>" +
                            "<td>" + (ProductsList[i].Item_Image1 ? "<img src='" + ProductsList[i].Item_Image1 + "' width='80' height='80' style='border-radius: 5px;' />" : "No Image") + "</td>" +
                            "<td>" + (ProductsList[i].Item_Image2 ? "<img src='" + ProductsList[i].Item_Image2 + "' width='80' height='80' style='border-radius: 5px;' />" : "No Image") + "</td>" +
                            "<td>" + (ProductsList[i].Item_Image3 ? "<img src='" + ProductsList[i].Item_Image3 + "' width='80' height='80' style='border-radius: 5px;' />" : "No Image") + "</td>" +
                            "<td class='center'>" + "<a href='#' class='btn btn-warning' data-toggle='modal' data-target='#Modal_Update_Products' onclick='Edit_Products(" + ProductsList[i].ID + ")' ><span class='glyphicon glyphicon-edit'></span> Update </a>" + "</td>" +
                            "</tr>";
                    }
                    else {
                        var Data = "<tr class='row_" + ProductsList[i].ID + "'>" +
                            "<td style='background-color: green;'>" + ProductsList[i].ItemID + "</td>" +
                            "<td style='background-color: green;'>" + ProductsList[i].ItemName + "</td>" +
                            "<td style='background-color: green;'>" + ProductsList[i].ItemQuantity + "</td>" +
                            "<td style='background-color: green;'>" + ProductsList[i].Item_Price + "</td>" +
                            "<td style='background-color: green;'>" + ProductsList[i].Item_Description + "</td>" +
                            "<td style='background-color: green;'>" + ProductsList[i].Item_Stock_limit + "</td>" +
                            "<td>" + (ProductsList[i].Item_Image1 ? "<img src='" + ProductsList[i].Item_Image1 + "' width='80' height='80' style='border-radius: 5px;' />" : "No Image") + "</td>" +
                            "<td>" + (ProductsList[i].Item_Image2 ? "<img src='" + ProductsList[i].Item_Image2 + "' width='80' height='80' style='border-radius: 5px;' />" : "No Image") + "</td>" +
                            "<td>" + (ProductsList[i].Item_Image3 ? "<img src='" + ProductsList[i].Item_Image3 + "' width='80' height='80' style='border-radius: 5px;' />" : "No Image") + "</td>" +
                            "<td class='center'>" + "<a href='#' class='btn btn-warning' data-toggle='modal' data-target='#Modal_Update_Products' onclick='Edit_Products(" + ProductsList[i].ID + ")' ><span class='glyphicon glyphicon-edit'></span> Update </a>" + "</td>" +
                            "</tr>";
                    }

                    SetData.append(Data);
                }
            },
            error: function (error) {
                $.notify(error);
            }
        });
    }

    function Edit_Products(productId) {
        $.ajax({
            type: "GET",
            url: '/StoreHandler/GetProductById/' + productId,
            success: function (product) {
                // Populate modal with product data
                $('#ProductID').val(product.ID);
                $('#ItemName').val(product.ItemName);
                $('#ItemQuantity').val(product.ItemQuantity);
                $('#ItemPrice').val(product.Item_Price);
                $('#ItemDescription').val(product.Item_Description);
                $('#ItemStockLimit').val(product.Item_Stock_limit);
            },
            error: function (error) {
                $.notify(error);
            }
        });
    }

    function updateProduct() {
        var productId = $('#ProductID').val();
        var itemName = $('#ItemName').val();
        var itemQuantity = $('#ItemQuantity').val();
        var itemPrice = $('#ItemPrice').val();
        var itemDescription = $('#ItemDescription').val();
        var itemStockLimit = $('#ItemStockLimit').val();

        $.ajax({
            type: "POST",
            url: '/StoreHandler/UpdateProduct',
            data: {
                ID: productId,
                ItemName: itemName,
                ItemQuantity: itemQuantity,
                Item_Price: itemPrice,
                Item_Description: itemDescription,
                Item_Stock_limit: itemStockLimit
            },
            success: function (response) {
                if (response.success) {
                    alert("Product updated successfully!");
                    $('#Modal_Update_Products').modal('hide');
                    GetAll_Items_Load(); // Reload the products list to show updated data
                } else {
                    alert("Error updating product.");
                }
            },
            error: function (error) {
                $.notify(error);
            }
        });
    }


</script>



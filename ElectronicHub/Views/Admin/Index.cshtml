<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script>


    google.charts.load('current', {
        packages: ['corechart'],
    }).then(function () {

        //Count Pie Chart Shipped
        $.ajax({
            type: "POST",
            url: "/Admin/Orders_Status",
            data: '{}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",

            success: function (jsonData) {

                var data = google.visualization.arrayToDataTable(jsonData);

                data.addColumn({ type: 'string', role: 'tooltip' });

                var options = {
                    tooltip: { isHtml: true },
                    'height': 300,
                    is3D: true,
                    chartArea: { 'width': '100%', 'height': '100%' },
                    colors: ['#008000', '#ffbf00', '#FF0000', '#4E6282', '#00FFFF'],
                    pieSliceText: 'value',
                    fontSize: 15,
                    legend: {
                        position: 'labeled'
                    },
                    //backgroundColor: { fill: 'transparent' },

                    animation:
                    {
                        "startup": true,
                        duration: 2000,
                        easing: 'out'
                    }
                };

                var chart = new google.visualization.PieChart(document.getElementById('div_Orders_Status'));

                chart.draw(data, options);


            },
            failure: function (r) {
                $.notify("Session TimeOut Please Log Again...!!", "error");
            },
            error: function (r) {
                $.notify("Session TimeOut Please Log Again...!!", "error");
            }
        });

        //Monthly Wise Orders Revenue
        $.ajax({
            type: "POST",
            url: "/Admin/Monthly_Wise_Sales",
            data: '{}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",

            success: function (jsonData) {
                // alert(jsonData);

                var data = google.visualization.arrayToDataTable(jsonData);

                var groupData = google.visualization.data.group(
                    data,
                    [{ column: 0, modifier: function () { return 'total' }, type: 'string' }],
                    [{ column: 1, aggregation: google.visualization.data.sum, type: 'number' }]
                );

                var formatPercent = new google.visualization.NumberFormat({
                    pattern: '#,##0.0%'
                });

                var formatShort = new google.visualization.NumberFormat({
                    pattern: 'short'
                });

                var view = new google.visualization.DataView(data);
                view.setColumns([0, 1, {
                    calc: function (dt, row) {
                        var percent = (dt.getValue(row, 1));
                        return percent;
                    },
                    type: 'number',
                    role: 'annotation'
                }]);

                var options = {
                    annotations: {
                        alwaysOutside: true
                    },
                    title: 'Monthly Wise Sales',
                    'height': 300,
                    legend: { position: 'top' },
                    'chartArea': { 'width': '90%' },
                    colors: ['purple'],
                };

                var chart = new google.visualization.ColumnChart(document.getElementById('chart_Monthly_Wise_Sales'));


                chart.draw(view, options);

            },
            failure: function (r) {
                $.notify("Session TimeOut Please Log Again...!!", "error");
            },
            error: function (r) {
                $.notify("Session TimeOut Please Log Again...!!", "error");
            }
        });

        //Item Wise Quantity
        $.ajax({
            type: "POST",
            url: "/Admin/Item_Wise_Quantity",
            data: '{}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",

            success: function (jsonData) {
                // alert(jsonData);

                var data = google.visualization.arrayToDataTable(jsonData);

                var groupData = google.visualization.data.group(
                    data,
                    [{ column: 0, modifier: function () { return 'total' }, type: 'string' }],
                    [{ column: 1, aggregation: google.visualization.data.sum, type: 'number' }]
                );

                var formatPercent = new google.visualization.NumberFormat({
                    pattern: '#,##0.0%'
                });

                var formatShort = new google.visualization.NumberFormat({
                    pattern: 'short'
                });

                var view = new google.visualization.DataView(data);
                view.setColumns([0, 1, {
                    calc: function (dt, row) {
                        var percent = (dt.getValue(row, 1));
                        return percent;
                    },
                    type: 'number',
                    role: 'annotation'
                }]);

                var options = {
                    annotations: {
                        alwaysOutside: true
                    },
                    title: 'Monthly Wise Sales',
                    'height': 300,
                    legend: { position: 'top' },
                    'chartArea': { 'width': '90%' },
                    colors: ['green'],
                };

                var chart = new google.visualization.ColumnChart(document.getElementById('chart_Item_Wise_Stocks'));

                chart.draw(view, options);

            },
            failure: function (r) {
                $.notify("Session TimeOut Please Log Again...!!", "error");
            },
            error: function (r) {
                $.notify("Session TimeOut Please Log Again...!!", "error");
            }
        });

    });

        $(document).ready(function () {
            //Get Count Breakdown Pending Count By Location
            //Preventive
            $.ajax({
                type: 'POST',
                url: '/StoreHandler/AwaitingShipmentCount',
                data: '{}',
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',

                success: function (jsonData) {
                    document.getElementById('AwaitingShipment_Count').innerHTML = jsonData;

                },
                failure: function (r) {
                    alert(r);
                },
                error: function (r) {
                    alert(r);
                }
            });
        //Shedule
        $.ajax({
            type: 'POST',
        url: '/StoreHandler/CompletedShipmentCount',
        data: '{}',
        contentType: 'application/json; charset=utf-8',
        dataType: 'json',

        success: function (jsonData) {
            document.getElementById('CompletedShipment_Count').innerHTML = jsonData;

            },
        failure: function (r) {
            alert(r);
            },
        error: function (r) {
            alert(r);
            }
        });

    });

</script>

